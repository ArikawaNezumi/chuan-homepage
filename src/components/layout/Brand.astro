---
import site from "@/config/site";
import { Image } from "astro:assets";
---

<div class="brand-root mb-6 flex items-center gap-4 md:mb-10">
  <div
    class="flex h-14 w-14 shrink-0 overflow-hidden rounded-full border-2 border-primary/10"
    transition:name="brand-logo"
  >
    <Image
      loading={"eager"}
      src={site.meta.logo}
      alt={"Site logo"}
      width={56}
      height={56}
      class="h-full w-full object-cover"
    />
  </div>
  <div class="brand-text">
    <h1
      data-pagefind-ignore
      class="brand-title text-lg font-bold tracking-tight text-foreground md:text-xl"
    >
      {site.meta.title}
    </h1>
  </div>
</div>

<style>
  @media (min-width: 48rem) {
    [data-sidebar-mode="writing"] .brand-root {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    [data-sidebar-mode="writing"] .brand-text {
      text-align: center;
    }

    [data-sidebar-mode="writing"] .brand-title {
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
  }
</style>
