---
import site from "@/config/site";
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;
---

<nav
  class="no-scrollbar flex flex-1 flex-col gap-2 overflow-x-visible md:gap-4"
>
  {
    site.navigation.map((item) => {
      const isActive =
        currentPath === item.href ||
        (item.href !== "/" && currentPath.startsWith(item.href));
      const navId = item.href.replace(/\//g, "") || "home";
      return (
        <a
          href={item.href}
          class:list={[
            "nav-link group flex w-full items-center justify-between rounded-2xl border border-transparent px-4 py-2.5 transition-all md:min-w-0 md:py-4",
            isActive
              ? "border-primary/20 bg-primary/10 md:hover:border-primary/20 md:hover:bg-primary/15"
              : "hover:bg-muted/50",
          ]}
          transition:name={`nav-${navId}`}
        >
          <div class="flex flex-col">
            <span
              class:list={[
                "nav-link__title text-sm font-bold",
                isActive
                  ? "text-primary"
                  : "text-muted-foreground group-hover:text-primary",
              ]}
            >
              {item.name}
            </span>
            <span
              class:list={[
                "text-[10px] tracking-widest uppercase",
                isActive ? "text-primary/60" : "text-muted-foreground/50",
              ]}
            >
              {item.subtitle}
            </span>
          </div>

          {isActive ? (
            <span class="nav-link__arrow hidden text-primary md:block">
              <Icon name="mdi:arrow-right" />
            </span>
          ) : (
            <span class="nav-link__arrow hidden -translate-x-2 text-primary opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100 md:block">
              <Icon name="mdi:arrow-right" />
            </span>
          )}
        </a>
      );
    })
  }
</nav>

<style>
  @media (min-width: 48rem) {
    [data-sidebar-mode="writing"] .nav-link {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    [data-sidebar-mode="writing"] .nav-link__title {
      font-size: 0.75rem;
      line-height: 1rem;
    }

    [data-sidebar-mode="writing"] .nav-link__arrow {
      display: none;
    }
  }
</style>

<script>
  function updateActiveNav() {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll("nav .nav-link");

    // Active classes
    const activeLink =
      "border-primary/20 bg-primary/10 md:hover:border-primary/20 md:hover:bg-primary/15";
    const inactiveLink = "hover:bg-muted/50";
    const activeTitle = "text-primary";
    const inactiveTitle = "text-muted-foreground group-hover:text-primary";
    const activeSubtitle = "text-primary/60";
    const inactiveSubtitle = "text-muted-foreground/50";

    navLinks.forEach((link) => {
      const href = link.getAttribute("href") || "";
      const isActive =
        currentPath === href || (href !== "/" && currentPath.startsWith(href));

      const titleEl = link.querySelector(".nav-link__title");
      const subtitleEl = link.querySelector(".text-\\[10px\\]");
      const arrowEl = link.querySelector(".nav-link__arrow");

      // Update link classes
      activeLink.split(" ").forEach((c) => link.classList.toggle(c, isActive));
      inactiveLink
        .split(" ")
        .forEach((c) => link.classList.toggle(c, !isActive));

      // Update title classes
      if (titleEl) {
        activeTitle
          .split(" ")
          .forEach((c) => titleEl.classList.toggle(c, isActive));
        inactiveTitle
          .split(" ")
          .forEach((c) => titleEl.classList.toggle(c, !isActive));
      }

      // Update subtitle classes
      if (subtitleEl) {
        activeSubtitle
          .split(" ")
          .forEach((c) => subtitleEl.classList.toggle(c, isActive));
        inactiveSubtitle
          .split(" ")
          .forEach((c) => subtitleEl.classList.toggle(c, !isActive));
      }

      // Update arrow visibility
      if (arrowEl) {
        if (isActive) {
          arrowEl.classList.remove(
            "-translate-x-2",
            "opacity-0",
            "group-hover:translate-x-0",
            "group-hover:opacity-100",
          );
        } else {
          arrowEl.classList.add(
            "-translate-x-2",
            "opacity-0",
            "group-hover:translate-x-0",
            "group-hover:opacity-100",
          );
        }
      }
    });
  }

  // Run on initial page load and after every View Transition
  document.addEventListener("astro:page-load", updateActiveNav);
</script>
